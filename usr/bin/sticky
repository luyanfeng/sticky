#!/bin/bash

# Resolve the script relative to this launcher's own location, so it works for
# a package installed to any prefix instead of relying on an absolute /usr path.
# The X11/Wayland backend choice is handled by sticky.py.
BINDIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

exec python3 "$BINDIR/../lib/sticky/sticky.py" "$@"
