#!/bin/bash

# Note positioning relies on the X11 backend. That backend works natively
# under Xorg sessions and under Wayland via XWayland, so force it whenever an
# X display is available. On Wayland sessions without XWayland there is no
# DISPLAY; let GTK pick the native backend instead - sticky.py then refuses
# to persist compositor-controlled window positions.
if [ -n "${DISPLAY:-}" ]; then
    export GDK_BACKEND="x11"
fi

/usr/lib/sticky/sticky.py $*
