#!/bin/bash

# Resolve the script from this launcher's own location so the app also runs
# from a relocatable bundle (AppImage) instead of an absolute /usr path.
# The X11/Wayland backend choice is handled by sticky.py.
BINDIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

exec python3 "$BINDIR/../lib/sticky/sticky.py" "$@"
